# copy this to .env, never commit real values
DB_URL=jdbc:postgresql://<host>:5432/<db>
DB_USER=
DB_PASSWORD=

# our token for calling the key service, has to match AUTH_SERVICE_TOKEN over there
SERVICE_TOKEN_AUTH=
# token the gateway sends to /internal/sessions/verify
SERVICE_TOKEN_GATEWAY=

# 32 bytes, base64, e.g. from openssl rand -base64 32
# never change it, the fake salts would change and give away which emails don't exist
PRELOGIN_SECRET=

# optional, these are the defaults
# KEY_SERVICE_URL=https://key.nexvent.de
# LOGIN_TOKEN_TTL_SECONDS=43200

# optional, extra browser origins, comma separated
# https://trustylynx.nexvent.de and localhost/127.0.0.1 on any port are always allowed
# CORS_ALLOWED_ORIGINS=https://app.nexvent.de

# optional, allows Origin "null" (frontend opened as a local file)
# local only, keep it false on the server: sandboxed iframes on any website can send "null" too
# CORS_ALLOW_NULL_ORIGIN=false
