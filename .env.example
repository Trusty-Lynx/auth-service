# Vorlage für .env – echte Werte nie committen.
DB_URL=jdbc:postgresql://<host>:5432/<db>
DB_USER=
DB_PASSWORD=

# Eigener Service-Token für Aufrufe an den Key-Service (muss dort als AUTH_SERVICE_TOKEN hinterlegt sein).
SERVICE_TOKEN_AUTH=
# Token, den das Gateway bei /internal/sessions/verify mitschickt.
SERVICE_TOKEN_GATEWAY=

# 32 Byte, Base64, z. B. aus: openssl rand -base64 32
# Nie ändern, sonst ändern sich alle Fake-Salts und verraten, welche E-Mails es nicht gibt.
PRELOGIN_SECRET=

# Optional, Default: https://key.nexvent.de
# KEY_SERVICE_URL=https://key.nexvent.de

# Optional, Default: 43200 (12 h)
# LOGIN_TOKEN_TTL_SECONDS=43200
